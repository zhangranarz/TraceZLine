(
	(
		source="/var/log/pods/spl-banking-*log"
		"[SPLMessage]" ("- Request -" OR "- Response -")
	)
	OR
	(
		source="/var/log/pods/spl-banking-*log"
		"[SPLHostMessage]" ("[Request]" OR "[Response]")
	)
	OR
	(
		source="/var/log/pods/spl-ms-*log"
		"*WSAppLog*" ("request:" OR "RESPONSE from" OR "Response:")
	)
	OR
	(
		source="/var/log/pods/spl-ms-*log"
		"<EAI>" "<SvcCode>" ("Request Message" OR "Response Message")
	)
)
("2576dfc8-495a-837a-8a2f291fd003d" OR "7f269c48-f03a-4fef-bc3007538ec1a2")
| eval LayerName=case(match(_raw,"\[SPLMessage\]"),"eComm",match(_raw,"\[SPLHostMessage\]"),"Enterprise",
    match(_raw,"<EAI>") AND match(_raw,"<SvcCode>"),"Host", match(_raw,"WSAppLog"),"WS")
| eval Layer=case(LayerName="eComm",1,LayerName="Enterprise",2,LayerName="WS",2,LayerName="Host",3)
| eval SubLayer=case(LayerName="eComm",0,LayerName="Enterprise",0,LayerName="WS",1,LayerName="Host",0)
| eval Direction=case(LayerName="eComm" AND match(_raw,"(?i)- Request -"),"Request",
    LayerName="eComm" AND match(_raw,"(?i)- Response -"),"Response",
    LayerName="Enterprise" AND match(_raw,"(?i)\[Request\]"),"Request",
    LayerName="Enterprise" AND match(_raw,"(?i)\[Response\]"),"Response",
    LayerName="Host" AND match(_raw,"(?i)Request Message"),"Request",
    LayerName="Host" AND match(_raw,"(?i)Response Message"),"Response",
    LayerName="WS" AND match(_raw,"(?i)request:"),"Request",
    LayerName="WS" AND match(_raw,"(?i)(RESPONSE from|Response:)"),"Response")
| where isnotnull(Direction)
| rex field=_raw "\"sessionId\"\s*:\s*\"(?<sidSessionId>[0-9a-fA-F-]{36})"
| rex field=_raw "\"sessionIdentity\"\s*:\s*\"(?<sidSessionIdentity>[0-9a-fA-F-]{36})"
| rex field=_raw "(?i)\[SPLMessage\]\s*\[?(?<sidEcomm>[0-9a-fA-F-]{36})"
| rex field=_raw "(?i)\[SPLHostMessage\]\s*\[?(?<sidEnterprise>[0-9a-fA-F-]{36})"
| rex field=_raw "(?i)\bWLS:\s*(?<sidWls>[0-9a-fA-F-]{36})"
| eval sessionId=coalesce(sidSessionId, sidSessionIdentity, sidEcomm, sidEnterprise, sidWls, "NA")
| rex field=_raw "\s*-\s*(?<eCommEndpoint>/\S+)\s*-\s*(?:Request|Response|\{|\r?\n|$)"
| rex field=_raw "\s*-\s*(?<EnterpriseEndpoint>/\S+)\s*-\s*\[(?:Request|Response)\]"
| rex field=_raw "\[::(?<DGEEndpoint>[^]]+)\]"
| rex field=_raw "\bURL(?:\s+is\s+|\s*:\s*)(?<URL>/[^\s:|]+)"
| eval Endpoint=case(LayerName="eComm",coalesce(eCommEndpoint,"N/A"),
    LayerName="Enterprise",coalesce(EnterpriseEndpoint,"N/A"),
    LayerName="WS",mvappend(coalesce(URL,"NA"),coalesce(DGEEndpoint,"NA")),
    LayerName="Host",coalesce(DGEEndpoint,"NA"))
| rex field=_raw max_match=0 "<SvcCode>(?<SvcCode>[^<]+)</SvcCode>"
| where LayerName!="Host" OR mvcount(SvcCode)>=1
| eval LayerOrder=Layer*10+SubLayer
| eval SortKey=if(Direction="Request",LayerOrder,-LayerOrder)
| sort 0 _time SortKey
| eval CurrentWsURL=if(LayerName="WS",URL,null())
| eval CurrentDGEEndpoint=if(LayerName="WS",DGEEndpoint,null())
| streamstats last(CurrentWsURL) as LastWsURL last(CurrentDGEEndpoint) as LastDGEEndpoint by sessionId
| eval pairIndex=if(LayerName="Host",mvrange(0,ceil(mvcount(SvcCode)/2)),null())
| eval HostPairs=if(LayerName="Host",mvmap(pairIndex, mvindex(SvcCode,pairIndex*2) . " ~ ".coalesce(mvindex(SvcCode,pairIndex*2+1),mvindex(SvcCode,pairIndex*2))),null())
| eval API=case(LayerName="eComm",coalesce(Endpoint,"N/A"),
    LayerName="Enterprise",coalesce(Endpoint,"N/A"),
    LayerName="WS",coalesce(URL,LastWsURL,DGEEndpoint,LastDGEEndpoint,"N/A"),
    LayerName="Host",Endpoint)
| eval DirectionSymbol=if(Direction="Request","?","!")
| eval PairKey=case(LayerName="Host",LayerName."|".Endpoint,true(),LayerName."|".coalesce(API,"N/A"))
| eval ReqTime=if(Direction="Request",_time,null())
| streamstats last(ReqTime) as LastReqTime by sessionId LayerName PairKey
| eval ElapsedMs=if(Direction="Response" AND isnotnull(LastReqTime),round((_time-LastReqTime)*1000,0),null())
| eval Indent=case(LayerName="eComm","",LayerName="Enterprise","> ",LayerName="Host",">>> ",LayerName="WS",">> ")
| eval DisplayLayer=if(LayerName="WS","WS [Enterprise]",LayerName)
| eval FlowHead=Indent.DisplayLayer.": ".if(LayerName="WS",mvindex(Endpoint,0),coalesce(API,"N/A"))." [".DirectionSymbol."]"
| eval ServiceLines=if(LayerName="Host",mvmap(HostPairs,"- [".HostPairs."] [".DirectionSymbol."]"),null())
| eval WsDetails=if(LayerName="WS",mvindex(Endpoint,1),null())
| eval Flow=case(LayerName="Host" AND isnotnull(ServiceLines),mvappend(FlowHead,ServiceLines),
    LayerName="WS" AND isnotnull(WsDetails),mvappend(FlowHead,WsDetails),
    true(),FlowHead)
| eval ServiceInfo=Flow
| rex field=_raw "(?i)\btransactionRef(?:erenceNumber)?\"?\s*[:=]\s*\"?(?<transactionRef>[^\",]+)"
| rex field=_raw "(?i)\btransactionCode\"?\s*[:=]\s*\"?(?<transactionCode>[^\",]+)"
| eval Params=mvappend(
    if(isnotnull(transactionRef) AND len(trim(transactionRef))>0,"TxnRefNo=".transactionRef, null()),
    if(isnotnull(transactionCode) AND len(trim(transactionCode))>0,"TxnCode=".transactionCode, null())
)
| streamstats count as Step by sessionId
| eval EventTime=strftime(_time,"%Y-%m-%d %H:%M:%S.%3N")
| table Step EventTime sessionId ServiceInfo Params ElapsedMs
